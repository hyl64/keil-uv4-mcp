root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# µVision artefacts are CRLF by contract; do not normalise them.
[*.{uvprojx,uvproj,uvoptx,uvmpw,dep,map,lnp,sct,BAT,hex}]
end_of_line = crlf
